{
  "container": "docker.io/assistos/bwrap-runner@sha256:9b6c08cf78fd0a29acfbe2e45ea2ee26efe6fde49c7f3db8b3aadfa30f2d53f8",
  "about": "Compatibility-only MCP wrapper around the shared local sandbox runner. Research provider agents use the bwrap-runner image directly and invoke /usr/local/bin/bwrap-sandbox-exec locally; they must not depend on this agent.",
  "agent": "node /code/bin/healthcheck.mjs && sh /Agent/server/AgentServer.sh",
  "readiness": {
    "protocol": "mcp"
  },
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 5,
      "timeout": 30,
      "failureThreshold": 12
    }
  },
  "profiles": {
    "default": {
      "ports": [
        "127.0.0.1:7119:7000"
      ],
      "mounts": {
        "code": "ro",
        "skills": "ro"
      },
      "preinstall": "scripts/build-image.sh",
      "env": {
        "BWRAP_RUNNER_IMAGE": {
          "default": "docker.io/assistos/bwrap-runner@sha256:9b6c08cf78fd0a29acfbe2e45ea2ee26efe6fde49c7f3db8b3aadfa30f2d53f8"
        },
        "BWRAP_RUNNER_MAX_TIMEOUT_MS": {
          "default": "120000"
        },
        "BWRAP_RUNNER_DEFAULT_TIMEOUT_MS": {
          "default": "30000"
        },
        "BWRAP_RUNNER_MAX_STDOUT_BYTES": {
          "default": "65536"
        },
        "BWRAP_RUNNER_MAX_STDERR_BYTES": {
          "default": "65536"
        },
        "BWRAP_RUNNER_ALLOW_NETWORK": {
          "default": "false"
        },
        "BWRAP_RUNNER_MAX_COMMAND_LENGTH": {
          "default": "4096"
        },
        "BWRAP_RUNNER_MAX_STDIN_BYTES": {
          "default": "1048576"
        },
        "BWRAP_RUNNER_MAX_STAGED_FILES": {
          "default": "64"
        },
        "BWRAP_RUNNER_MAX_STAGED_FILE_BYTES": {
          "default": "262144"
        },
        "BWRAP_RUNNER_MAX_STAGED_TOTAL_BYTES": {
          "default": "1048576"
        },
        "BWRAP_RUNNER_RUNTIME_ROOT": {
          "default": "/data/research-runtimes"
        }
      }
    }
  },
  "runtime": {
    "resources": {
      "persistentStorage": {
        "key": "bwrap-runner",
        "containerPath": "/var/lib/ploinky-bwrap-runner",
        "chmod": 448
      },
      "env": {
        "BWRAP_RUNNER_STATE": "{{STORAGE_CONTAINER_PATH}}"
      }
    }
  }
}
