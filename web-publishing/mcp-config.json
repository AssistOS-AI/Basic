{
  "tools": [
    {
      "name": "web_publishing_status",
      "title": "Web Publishing status",
      "description": "Return redacted nginx, cloudflared, route, and provider status.",
      "command": "node",
      "args": ["tools/web-publishing-tool.mjs"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "env": { "TOOL_NAME": "web_publishing_status" },
      "inputSchema": {},
      "tags": ["admin"]
    },
    {
      "name": "web_publishing_config_get",
      "title": "Get Web Publishing config",
      "description": "Return the saved Web Publishing config with secret fields represented by presence flags.",
      "command": "node",
      "args": ["tools/web-publishing-tool.mjs"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "env": { "TOOL_NAME": "web_publishing_config_get" },
      "inputSchema": {},
      "tags": ["admin"]
    },
    {
      "name": "web_publishing_config_validate",
      "title": "Validate Web Publishing config",
      "description": "Validate a draft Web Publishing route model without mutating local or Cloudflare state.",
      "command": "node",
      "args": ["tools/web-publishing-tool.mjs"],
      "cwd": "/code",
      "timeoutMs": 30000,
      "env": { "TOOL_NAME": "web_publishing_config_validate" },
      "inputSchema": {
        "config": {
          "type": "object",
          "optional": true,
          "properties": {
            "mode": { "type": "string", "enum": ["nginx", "token", "cloudflare-token", "cloudflare-api", "nginx-cloudflare"], "optional": true },
            "tlsEdge": { "type": "string", "enum": ["none", "cloudflare", "external"], "optional": true },
            "baseDomain": { "type": "string", "optional": true },
            "publicUrl": { "type": "string", "optional": true },
            "livekitMediaIp": { "type": "string", "optional": true },
            "turnExternalIp": { "type": "string", "optional": true },
            "tunnel": {
              "type": "object",
              "optional": true,
              "properties": {
                "source": { "type": "string", "optional": true },
                "tokenSet": { "type": "boolean", "optional": true },
                "tunnelId": { "type": "string", "optional": true },
                "tunnelName": { "type": "string", "optional": true }
              },
              "additionalProperties": false
            },
            "exposures": {
              "type": "array",
              "optional": true,
              "items": {
                "type": "object",
                "properties": {
                  "id": { "type": "string", "optional": true },
                  "enabled": { "type": "boolean", "optional": true },
                  "hostname": { "type": "string" },
                  "path": { "type": "string", "optional": true },
                  "originId": { "type": "string" },
                  "service": { "type": "string", "optional": true },
                  "description": { "type": "string", "optional": true }
                },
                "additionalProperties": false
              }
            }
          },
          "additionalProperties": false
        }
      },
      "tags": ["admin"]
    },
