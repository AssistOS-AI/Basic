{
  "container": "docker.io/assistos/webtty-agent@sha256:8ff65bb742dd9f85fe7b8e319e4b4626f4d7b373e62ce09f48d52fb5bc5cd1c7",
  "about": "Browser terminal that runs bash inside an isolated container, scoped to a workspace folder.",
  "start": "/usr/local/bin/webtty-v5-start",
  "readiness": {
    "protocol": "tcp"
  },
  "httpServices": [
    {
      "slug": "webtty",
      "externalPrefix": "/services/webtty/",
      "internalPrefix": "/",
      "access": "authenticated",
      "port": 7681
    }
  ],
  "volumes": {
    ".": "/workspace"
  },
  "profiles": {
    "default": {
      "mounts": {
        "code": "ro"
      },
      "env": {
        "PORT": {
          "default": "7681"
        },
        "SHELL": {
          "default": "/bin/bash"
        }
      }
    }
  }
}
