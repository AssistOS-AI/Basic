{
  "container": "docker.io/assistos/webtty-agent:node24",
  "about": "Browser terminal that runs bash inside an isolated container, scoped to a workspace folder.",
  "start": "/usr/local/bin/webtty-start",
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 1,
      "timeout": 3,
      "failureThreshold": 30,
      "successThreshold": 1
    }
  },
  "routerAccess": {
    "httpRoutes": [
      {
        "path": "/base-agent-additional-server/webtty/7681/*",
        "access": "authenticated"
      }
    ]
  },
  "volumes": {
    ".": "/workspace"
  },
  "profiles": {
    "default": {
      "mounts": {
        "code": "ro"
      },
      "env": {
        "PORT": {
          "default": "7681"
        },
        "WEBTTY_PORT": {
          "default": "7681"
        },
        "SHELL": {
          "default": "/bin/bash"
        }
      }
    }
  }
}
