{
  "container": "assistos/webtty-agent:node24",
  "about": "Browser terminal that runs bash inside an isolated container, scoped to a workspace folder.",
  "start": "node /opt/webtty-agent/server.mjs",
  "readiness": {
    "protocol": "tcp"
  },
  "routerAccess": {
    "httpRoutes": [
      {
        "path": "/stream",
        "access": "authenticated"
      },
      {
        "path": "/input",
        "access": "authenticated"
      },
      {
        "path": "/resize",
        "access": "authenticated"
      },
      {
        "path": "/whoami",
        "access": "authenticated"
      },
      {
        "path": "/assets/*",
        "access": "authenticated"
      }
    ]
  },
  "volumes": {
    ".": "/workspace"
  },
  "profiles": {
    "default": {
      "ports": [
        "127.0.0.1:7681:7681"
      ],
      "mounts": {
        "code": "ro"
      },
      "env": {
        "PORT": {
          "default": "7681"
        },
        "SHELL": {
          "default": "/bin/bash"
        }
      }
    }
  }
}
