{
  "container": "docker.io/assistos/webtty-agent:node24",
  "about": "Browser terminal that runs bash inside an isolated container, scoped to a workspace folder.",
  "start": "/usr/local/bin/webtty-start",
  "health": {
    "readiness": {
      "script": "healthcheck.sh",
      "interval": 1,
      "timeout": 3,
      "failureThreshold": 30,
      "successThreshold": 1
    }
  },
  "httpServices": [
    {
      "slug": "webtty",
      "port": 7681,
      "externalPrefix": "/services/webtty/",
      "internalPrefix": "/",
      "access": "authenticated"
    }
  ],
  "volumes": {
    ".": "/workspace"
  },
  "profiles": {
    "default": {
      "mounts": {
        "code": "ro"
      },
      "env": {
        "PORT": {
          "default": "7681"
        },
        "SHELL": {
          "default": "/bin/bash"
        }
      }
    }
  }
}
